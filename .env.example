# ==============================================================================
# SuperRR Selector 2.0 – Production Environment Configuration
# ==============================================================================
# The application runs as a high-performance client-side intelligence platform
# using audited historical T20/IPL datasets bundled within the application.
#
# No sensitive database credentials or private API keys are required for core features.
# You can configure the optional variables below in Vercel Project Settings if needed.

# Application Identity & Mode
VITE_APP_TITLE=Super RR Selector 2.0
VITE_APP_DESCRIPTION=Rajasthan Royals Cricket Performance & Scouting Intelligence Platform
VITE_APP_ENV=production
VITE_ANALYTICS_VERSION=2.0.0

# Optional Public Base URL (defaults to Vercel production deployment URL)
# VITE_PUBLIC_URL=https://your-project.vercel.app
